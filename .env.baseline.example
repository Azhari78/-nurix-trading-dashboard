# Baseline profile overrides
# Use with: ./switch_profile.sh baseline

PAPER_TRADING=true
PAPER_WALLET_ENABLED=true
PAPER_WALLET_START_USD=10000
AUTO_TRADE_SYMBOLS=AAPL,MSFT,NVDA
AUTO_TRADE_STRATEGY_MODE=long_only
AUTO_TRADE_ENABLE_SHORT=false
AUTO_TRADE_MAX_OPEN_POSITIONS=1

# Use fixed size for slower, more consistent exposure.
TRADE_SIZE_USD=20
TRADE_SIZE_USD_MIN=10
TRADE_SIZE_USD_MAX=30
TRADE_SIZE_PERCENT=0

# Tighter daily risk cap.
MAX_DAILY_LOSS_USD=30

# Exit bila unrealized PnL capai minimum ini (0 = bila untung sikit pun terus exit).
AUTO_TRADE_TP_AND_RUN_ENABLED=true
AUTO_TRADE_TP_AND_RUN_MIN_PNL_PCT=0.0
